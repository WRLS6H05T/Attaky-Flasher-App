<?xml version="1.0" encoding="utf-8"?>
<!--
  The Attaky website palette, taken from the store's own CSS custom properties
  (https://fwstore.attaky.com). The app mirrors that theme: an off-white page,
  white cards with a hairline border, near-black ink, and the brand red kept for
  the logo and the one primary action on a screen.
-->
<resources>
    <!-- The page behind the cards. -->
    <color name="attaky_bg">#FFFAFAFA</color>
    <!-- White: the header and every card. -->
    <color name="attaky_surface">#FFFFFFFF</color>
    <!-- The splash is a chrome-free white screen, like the site header. -->
    <color name="attaky_boot_bg">#FFFFFFFF</color>

    <!-- Headings and body copy. -->
    <color name="attaky_ink">#FF141414</color>
    <color name="attaky_muted">#FF5C5C5C</color>
    <!-- Hairline around cards and fields. -->
    <color name="attaky_border">#FFE5E5E5</color>
    <!-- Form errors. -->
    <color name="attaky_danger">#FFE53E3E</color>

    <!-- The wordmark red, also the primary button. -->
    <color name="attaky_red">#FFC72B2F</color>
    <!-- The same red a shade down, for the pressed state. -->
    <color name="attaky_red_press">#FFA82327</color>
    <!-- Neutral press wash for cards and outline controls. -->
    <color name="attaky_press">#FFF2F2F2</color>

    <!-- White, because the launcher mark is the red monogram on white. -->
    <color name="attaky_launcher_background">#FFFFFFFF</color>

    <!--
      The dark theme. Same instrument-panel layout, near-black page: a cool
      graphite that keeps the red readable, with the wordmark switched to the
      light asset (attaky_logo_dark.png).
    -->
    <color name="attaky_bg_dark">#FF0D0D0E</color>
    <color name="attaky_surface_dark">#FF17181A</color>
    <color name="attaky_well_dark">#FF111214</color>
    <color name="attaky_ink_dark">#FFF2F2F3</color>
    <color name="attaky_muted_dark">#FF9EA0A6</color>
    <color name="attaky_border_dark">#FF2A2B2F</color>
    <color name="attaky_press_dark">#FF202124</color>
    <!--
      The site's own red, untinted: a lighter variant read as a different brand
      colour on a near-black page, so both themes use the store's primary red
      (#C72B2F) exactly.
    -->
    <color name="attaky_red_dark">#FFC72B2F</color>
    <color name="attaky_red_press_dark">#FFA82327</color>

    <!-- The text-colour swatches offered in Settings. -->
    <color name="swatch_white">#FFFFFFFF</color>
    <color name="swatch_ink">#FF141414</color>
    <color name="swatch_red">#FFC72B2F</color>
    <color name="swatch_amber">#FFD98324</color>
    <color name="swatch_green">#FF2F9E58</color>
    <color name="swatch_blue">#FF2D6CDF</color>
    <color name="swatch_violet">#FF8B5CF6</color>

    <!--
      The neon category: saturated sign colours, picked to sit on the dark page
      (they are offered in the light one too, where they are loud rather than
      unreadable). They are ordinary text tones — the headings, the values and,
      with them, the action buttons.
    -->
    <color name="swatch_neon_green">#FF39FF14</color>
    <color name="swatch_neon_cyan">#FF00E5FF</color>
    <color name="swatch_neon_blue">#FF3D5AFE</color>
    <color name="swatch_neon_violet">#FFB14AFF</color>
    <color name="swatch_neon_magenta">#FFFF2BD6</color>
    <color name="swatch_neon_red">#FFFF2D55</color>
    <color name="swatch_neon_orange">#FFFF8A00</color>
    <color name="swatch_neon_yellow">#FFFFEA00</color>
</resources>
