<?xml version="1.0" encoding="utf-8"?>
<!--
  A confirmation opened over the dark theme: the same card the pages are built
  from — the dark surface, a hairline border, softly rounded — instead of the
  flat near-black rectangle a bare colour paints edge to edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/attaky_surface_dark" />
    <stroke
        android:width="1dp"
        android:color="@color/attaky_border_dark" />
    <corners android:radius="14dp" />
</shape>
