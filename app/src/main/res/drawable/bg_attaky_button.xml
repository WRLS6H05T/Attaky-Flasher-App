<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary control: the store's outline button — white with a hairline border,
  filling a shade of grey while pressed.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/attaky_press" />
            <stroke android:width="1dp" android:color="@color/attaky_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/attaky_surface" />
            <stroke android:width="1dp" android:color="@color/attaky_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
