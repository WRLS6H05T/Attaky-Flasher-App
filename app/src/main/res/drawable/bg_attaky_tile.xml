<?xml version="1.0" encoding="utf-8"?>
<!--
  Tappable card, matching the firmware tiles on the store: white, 1dp hairline,
  softly rounded. A press just washes the white a shade down.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/attaky_press" />
            <stroke android:width="1dp" android:color="@color/attaky_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/attaky_surface" />
            <stroke android:width="1dp" android:color="@color/attaky_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
