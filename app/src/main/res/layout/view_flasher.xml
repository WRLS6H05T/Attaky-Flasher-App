<?xml version="1.0" encoding="utf-8"?>
<!--
  The native offline flasher. Reached from the boot chooser's "Downloaded
  Firmware" tile and from the store's floating escape button. Everything here is
  local: the deck is driven over USB, firmware comes from the phone's own storage
  (or files the user picks), and nothing needs the network except the Store link.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flasherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/attaky_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/attaky_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/switzer_medium"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="←"
            android:textColor="@color/attaky_ink"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:letterSpacing="0.16"
            android:text="FLASHER"
            android:textColor="@color/attaky_ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStore"
            style="@style/AttakyButton"
            android:text="FIRMWARE STORE" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/flasherScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Deck -->
            <LinearLayout style="@style/AttakyCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AttakySectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Deck" />

                    <TextView
                        android:id="@+id/connPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="not connected"
                        android:textColor="@color/attaky_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_marginTop="8dp"
                    android:text="Plug the Attaky deck into USB, then connect to read the chip."
                    style="@style/AttakyBody" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConnect"
                        style="@style/AttakyPrimaryButton"
                        android:text="CONNECT" />

                    <Button
                        android:id="@+id/btnRescan"
                        style="@style/AttakyButton"
                        android:layout_marginStart="8dp"
                        android:text="RESCAN" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipInfo"
                    style="@style/AttakyMono"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Progress -->
            <LinearLayout
                android:id="@+id/progressBox"
                style="@style/AttakyCard"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <TextView
                    android:id="@+id/progressText"
                    style="@style/AttakyBody"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Firmware already on the phone -->
            <LinearLayout style="@style/AttakyCard">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:text="Downloaded firmware" />

                <TextView
                    style="@style/AttakyBody"
                    android:layout_marginTop="6dp"
                    android:text="Images the store saved on this device. Flash them with no network." />

                <LinearLayout
                    android:id="@+id/firmwareList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/firmwareEmpty"
                    style="@style/AttakyBody"
                    android:layout_marginTop="10dp"
                    android:text="No downloaded firmware."
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Local .bin files -->
            <LinearLayout style="@style/AttakyCard">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:text="Local .bin files" />

                <TextView
                    style="@style/AttakyBody"
                    android:layout_marginTop="6dp"
                    android:text="Pick .bin files from this device and set the flash offset for each." />

                <Button
                    android:id="@+id/btnPickFiles"
                    style="@style/AttakyButton"
                    android:layout_marginTop="10dp"
                    android:text="CHOOSE FILES" />

                <LinearLayout
                    android:id="@+id/localFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnFlashLocal"
                    style="@style/AttakyPrimaryButton"
                    android:layout_marginTop="10dp"
                    android:text="FLASH LOCAL FILES"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Advanced -->
            <LinearLayout style="@style/AttakyCard">

                <LinearLayout
                    android:id="@+id/advancedToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AttakySectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Advanced" />

                    <TextView
                        android:id="@+id/advancedChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/switzer_medium"
                        android:text="▾"
                        android:textColor="@color/attaky_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advancedBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/AttakyBody"
                        android:layout_marginTop="12dp"
                        android:text="Baud rate" />

                    <EditText
                        android:id="@+id/baudInput"
                        style="@style/AttakyInput"
                        android:layout_marginTop="6dp"
                        android:inputType="number"
                        android:maxLength="7" />

                    <CheckBox
                        android:id="@+id/checkVerify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/switzer_regular"
                        android:text="Verify the image after writing"
                        android:textColor="@color/attaky_ink"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/checkCompress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/switzer_regular"
                        android:text="Compress while writing"
                        android:textColor="@color/attaky_ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Log -->
            <LinearLayout style="@style/AttakyCard">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:text="Log" />

                <TextView
                    android:id="@+id/console"
                    style="@style/AttakyMono"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/flasherVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.1"
                android:textColor="@color/attaky_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
