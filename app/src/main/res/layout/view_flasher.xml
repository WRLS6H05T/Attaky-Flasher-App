<?xml version="1.0" encoding="utf-8"?>
<!--
  The native offline flasher. Reached from the boot chooser's "Downloaded
  Firmware" tile and from the store's floating escape button. Everything here is
  local: the core is driven over USB and firmware comes from the images the
  store already saved on this device. Nothing here needs the network at all: the
  corner button goes back to the menu, where the store is a tile.

  The `android:tag="attaky:..."` values tell AttakyTheme what each part is, so
  the screen repaints in either palette and in the user's chosen text colours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flasherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="attaky:bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <!--
          The header is the button alone: no arrow and no title, so the corner it
          occupies is the same one the menu's SETTINGS button sits in, in the same
          box, and nothing moves when this screen opens over the menu.
        -->
        <Button
            android:id="@+id/btnMenu"
            style="@style/AttakyButton"
            android:gravity="center"
            android:minWidth="112dp"
            android:tag="attaky:outline"
            android:text="@string/menu_title" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/flasherScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Deck -->
            <LinearLayout
                style="@style/AttakyCard"
                android:tag="attaky:card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AttakySectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:tag="attaky:muted"
                        android:text="Core" />

                    <TextView
                        android:id="@+id/connPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:tag="attaky:muted"
                        android:text="not connected"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    style="@style/AttakyBody"
                    android:layout_marginTop="8dp"
                    android:tag="attaky:muted"
                    android:text="Plug the Attaky core into USB, then connect to read the chip." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConnect"
                        style="@style/AttakyPrimaryButton"
                        android:tag="attaky:primary"
                        android:text="CONNECT" />

                    <Button
                        android:id="@+id/btnRescan"
                        style="@style/AttakyButton"
                        android:layout_marginStart="8dp"
                        android:tag="attaky:outline"
                        android:text="RESCAN" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipInfo"
                    style="@style/AttakyMono"
                    android:layout_marginTop="12dp"
                    android:tag="attaky:ink"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Progress -->
            <LinearLayout
                android:id="@+id/progressBox"
                style="@style/AttakyCard"
                android:tag="attaky:card"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:tag="attaky:progress" />

                <TextView
                    android:id="@+id/progressText"
                    style="@style/AttakyBody"
                    android:layout_marginTop="8dp"
                    android:tag="attaky:muted" />
            </LinearLayout>

            <!-- Firmware already on the phone -->
            <LinearLayout
                style="@style/AttakyCard"
                android:tag="attaky:card">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:layout_width="match_parent"
                    android:tag="attaky:muted"
                    android:text="Downloaded firmware" />

                <TextView
                    style="@style/AttakyBody"
                    android:layout_marginTop="6dp"
                    android:tag="attaky:muted"
                    android:text="Images the store saved on this device. Flash them with no network." />

                <LinearLayout
                    android:id="@+id/firmwareList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/firmwareEmpty"
                    style="@style/AttakyBody"
                    android:layout_marginTop="10dp"
                    android:tag="attaky:muted"
                    android:text="No downloaded firmware."
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Advanced -->
            <LinearLayout
                style="@style/AttakyCard"
                android:tag="attaky:card">

                <LinearLayout
                    android:id="@+id/advancedToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/AttakySectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:tag="attaky:muted"
                        android:text="Advanced" />

                    <TextView
                        android:id="@+id/advancedChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/switzer_medium"
                        android:tag="attaky:muted"
                        android:text="▾"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advancedBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/AttakyBody"
                        android:layout_marginTop="12dp"
                        android:tag="attaky:muted"
                        android:text="Baud rate" />

                    <EditText
                        android:id="@+id/baudInput"
                        style="@style/AttakyInput"
                        android:layout_marginTop="6dp"
                        android:inputType="number"
                        android:maxLength="7"
                        android:tag="attaky:outline" />

                    <CheckBox
                        android:id="@+id/checkVerify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/switzer_regular"
                        android:tag="attaky:check"
                        android:text="Verify the image after writing"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/checkCompress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/switzer_regular"
                        android:tag="attaky:check"
                        android:text="Compress while writing"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Log -->
            <LinearLayout
                style="@style/AttakyCard"
                android:tag="attaky:card">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:layout_width="match_parent"
                    android:tag="attaky:muted"
                    android:text="Log" />

                <TextView
                    android:id="@+id/console"
                    style="@style/AttakyMono"
                    android:layout_marginTop="8dp"
                    android:tag="attaky:ink"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/flasherVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.1"
                android:tag="attaky:muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
