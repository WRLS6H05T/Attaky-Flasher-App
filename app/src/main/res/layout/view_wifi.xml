<?xml version="1.0" encoding="utf-8"?>
<!--
  Send firmware to the core's SD card over WiFi. The core runs its own web
  server (launcher: MENU → Start Web User Interface), so no cable and no card
  reader are needed: this screen finds it on the network, logs in, and posts the
  image to the card's root, exactly where the core's own SD flasher looks.

  The `android:tag="attaky:..."` values tell AttakyTheme what each part is, so
  the screen repaints in either palette and in the user's chosen text colours.

  The header is the MENU button in the same box, at the same 20dp/10dp corner,
  as the menu's SETTINGS and the flasher's MENU. No back arrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wifiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="attaky:bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:letterSpacing="0.16"
            android:tag="attaky:ink"
            android:text="@string/wifi_title"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnMenu"
            style="@style/AttakyButton"
            android:gravity="center"
            android:minWidth="112dp"
            android:tag="attaky:outline"
            android:text="@string/menu_title" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/wifiScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Scanning state, and the one action that restarts the search. -->
            <LinearLayout
                style="@style/AttakyCard"
                android:layout_marginTop="10dp"
                android:tag="attaky:card">

                <TextView
                    android:id="@+id/wifiStatus"
                    style="@style/AttakyBody"
                    android:tag="attaky:muted" />

                <ProgressBar
                    android:id="@+id/wifiScanBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:tag="attaky:progress"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/wifiScan"
                    style="@style/AttakyPrimaryButton"
                    android:layout_marginTop="12dp"
                    android:tag="attaky:primary"
                    android:text="@string/wifi_scan_again" />
            </LinearLayout>

            <!-- The core, once it has answered. -->
            <LinearLayout
                android:id="@+id/wifiDeckCard"
                style="@style/AttakyCard"
                android:tag="attaky:card"
                android:visibility="gone">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:layout_width="match_parent"
                    android:tag="attaky:muted"
                    android:text="@string/wifi_deck_label" />

                <TextView
                    android:id="@+id/wifiDeckHost"
                    style="@style/AttakyCardTitle"
                    android:layout_marginTop="6dp"
                    android:tag="attaky:ink" />

                <TextView
                    android:id="@+id/wifiDeckInfo"
                    style="@style/AttakyBody"
                    android:layout_marginTop="4dp"
                    android:tag="attaky:muted" />
            </LinearLayout>

            <!-- The core's web login, stored on the core, not here. -->
            <LinearLayout
                style="@style/AttakyCard"
                android:tag="attaky:card">

                <TextView
                    style="@style/AttakySectionLabel"
                    android:layout_width="match_parent"
                    android:tag="attaky:muted"
                    android:text="@string/wifi_login_label" />

                <!-- The address the core prints on its own screen, for when a sweep misses it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/wifiAddress"
                        style="@style/AttakyInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/wifi_address_hint"
                        android:imeOptions="actionGo"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="1"
                        android:tag="attaky:outline" />

                    <Button
                        android:id="@+id/wifiConnect"
                        style="@style/AttakyButton"
                        android:layout_marginStart="8dp"
                        android:tag="attaky:outline"
                        android:text="@string/wifi_connect" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/wifiUser"
                        style="@style/AttakyInput"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:hint="@string/wifi_user_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:tag="attaky:outline" />

                    <EditText
                        android:id="@+id/wifiPass"
                        style="@style/AttakyInput"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/wifi_pass_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:tag="attaky:outline" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/AttakySectionLabel"
                android:layout_marginTop="20dp"
                android:tag="attaky:muted"
                android:text="@string/wifi_firmware_label" />

            <TextView
                android:id="@+id/wifiEmpty"
                style="@style/AttakyBody"
                android:layout_marginTop="8dp"
                android:tag="attaky:muted"
                android:text="@string/wifi_empty"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/wifiList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/AttakyBody"
                android:layout_marginTop="20dp"
                android:tag="attaky:muted"
                android:text="@string/wifi_help" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
