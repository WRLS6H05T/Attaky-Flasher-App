<?xml version="1.0" encoding="utf-8"?>
<!-- One image on the phone, with a plus to post it to the deck's card over WiFi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- The firmware's own app icon, saved with the image so it works offline. -->
    <ImageView
        android:id="@+id/wifiBinIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/firmware_icon"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_foreground"
        android:tag="attaky:well" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wifiBinName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:maxLines="2"
            android:tag="attaky:ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wifiBinMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/switzer_regular"
            android:tag="attaky:muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/wifiBinProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:tag="attaky:progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wifiBinState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/switzer_medium"
            android:tag="attaky:accent"
            android:text="@string/wifi_sent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Install into the deck's own app slot over the network: no card involved. -->
    <TextView
        android:id="@+id/wifiBinOta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/wifi_ota_desc"
        android:focusable="true"
        android:fontFamily="@font/jetbrains_mono_semibold"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingTop="9dp"
        android:paddingEnd="8dp"
        android:paddingBottom="9dp"
        android:tag="attaky:ink"
        android:text="@string/wifi_ota"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wifiBinSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/wifi_send_desc"
        android:focusable="true"
        android:fontFamily="@font/switzer_medium"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:tag="attaky:accent"
        android:text="@string/wifi_send"
        android:textSize="20sp" />
</LinearLayout>
