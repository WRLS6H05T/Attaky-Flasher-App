<?xml version="1.0" encoding="utf-8"?>
<!--
  Boot splash, styled after the site itself: the store's wordmark — the same
  artwork https://fwstore.attaky.com serves in its header — in the brand red on
  the same white, with the app name and build underneath.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/attaky_boot_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:id="@+id/splashLockup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/attaky_name"
            android:src="@drawable/attaky_logo" />

        <TextView
            android:id="@+id/splashWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:letterSpacing="0.34"
            android:text="@string/attaky_flasher_wordmark"
            android:textColor="@color/attaky_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/bootVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:letterSpacing="0.12"
            android:textColor="@color/attaky_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
